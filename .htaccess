<IfModule mod_deflate.c>

    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml font/ttf application/vnd.ms-fontobject

</IfModule>

<IfModule mod_headers.c>

    # Assets versionnés par ?v= (voir widgets/import) : cache d'un an
    <FilesMatch "\.(css|js|eot|ttf|woff2?)$">

        Header set Cache-Control "public, max-age=31536000, immutable"

    </FilesMatch>

    # Fichiers sans version dans l'URL : cache d'une semaine
    <FilesMatch "\.(jpe?g|png|webp|ico|svg|mp4|webm)$">

        Header set Cache-Control "public, max-age=604800"

    </FilesMatch>

    # Pages PHP : revalidation ; setIfEmpty conserve les en-têtes de session_start()
    <FilesMatch "\.php$">

        Header setIfEmpty Cache-Control "no-cache"

    </FilesMatch>

    # Security headers
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    Header always set Strict-Transport-Security "max-age=31536000"

</IfModule>

ErrorDocument 401 /pages/erreur/403.php
ErrorDocument 403 /pages/erreur/403.php
ErrorDocument 404 /pages/erreur/404.php